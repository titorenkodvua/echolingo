{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Debug Backend",
        "program": "${workspaceFolder}/backend/server.js",
        "cwd": "${workspaceFolder}/backend",
        "console": "integratedTerminal",
        "env": {
          "NODE_ENV": "development"
        },
        "skipFiles": [
          "<node_internals>/**"
        ]
      },
      {
        "type": "node",
        "request": "launch",
        "name": "Debug Frontend (Vite)",
        "runtimeExecutable": "npm",
        "runtimeArgs": [
          "run",
          "dev"
        ],
        "cwd": "${workspaceFolder}/frontend",
        "console": "integratedTerminal"
      }
    ],
    "compounds": [
      {
        "name": "Debug Full Stack (Backend + Frontend)",
        "configurations": ["Debug Backend", "Debug Frontend (Vite)"]
      }
    ]
  }